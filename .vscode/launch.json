{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SVG Outline Lab",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "--profile-temp",
        "${workspaceFolder}/vscode-extension/examples"
      ],
      "outFiles": ["${workspaceFolder}/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "build SVG extension"
    }
  ]
}
